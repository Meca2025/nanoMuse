{
	# Let's Encrypt writes to this address when a certificate is about to expire
	# and could not be renewed. Empty is allowed; scripts/self-host.sh fills it in.
	email "{$ACME_EMAIL}"
}

{$CLOUD_DOMAIN} {
	encode zstd gzip
	# Streams must not be buffered; Caddy flushes SSE by default, this just
	# makes the intent explicit and lifts the body limit for image edits.
	request_body {
		max_size 8MB
	}
	reverse_proxy relay:8787 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}
}
