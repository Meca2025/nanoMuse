{
  "name": "nanomuse-desktop-app",
  "private": true,
  "version": "0.1.29",
  "description": "nanoMuse for the desktop: the local runtime in a window, a tray, and a stage that shows where the hands are about to click.",
  "homepage": "https://nanomuse.cn/",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron out/main/index.js",
    "stage-demo": "electron-vite build && electron out/main/index.js --stage-demo",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "npm run typecheck && npm run build",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  },
  "author": {
    "name": "lgy0404",
    "email": "2528379691@qq.com"
  }
}
